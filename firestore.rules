rules_version = '2';

/* =====================================================================
   FIREBASE SECURITY RULES — Progress Printshop Workspace
   Project : progress-workspace
   Deploy  : Firebase Console > Firestore Database > Rules > Publish
   ---------------------------------------------------------------------
   ⚠ URUTAN WAJIB (jangan dibalik):
     (1) Authentication > Sign-in method > aktifkan "Anonymous"
     (2) Baru publish rules ini
   Rules ini memakai `isAuthed()` = `request.auth != null`.
   Kalau (1) belum dilakukan, semua operasi akan ditolak
   dengan "Missing or insufficient permissions".

   Untuk versi tanpa Authentication (lebih sederhana), lihat
   bagian "VARIAN B" di akhir file.
   ===================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helper ---------- */
    function isAuthed() {
      return request.auth != null;
    }
    function isNum(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }
    function isText(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    function isOptNum(v) {
      return !(v in request.resource.data) || v == null || isNum(v);
    }

    /* ---------- Customer Loyal + Rate ----------
       Ditulis: { name, rateDtf, ratePlastisol, createdAt } */
    match /design_customers/{id} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && isText(request.resource.data.name, 120)
                    && isNum(request.resource.data.rateDtf)
                    && isNum(request.resource.data.ratePlastisol);
      allow update: if isAuthed()
                    && isText(request.resource.data.name, 120)
                    && isNum(request.resource.data.rateDtf)
                    && isNum(request.resource.data.ratePlastisol);
      allow delete: if isAuthed();
    }

    /* ---------- Pesanan Desain ----------
       Ditulis: { customer, stage:"design", deadline, ..., createdAt }
       Diubah : stage bebas design/revisi/done (majur & mundur) */
    match /design_orders/{id} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && isText(request.resource.data.customer, 120)
                    && request.resource.data.stage == "design"
                    && isText(request.resource.data.deadline, 20);
      allow update: if isAuthed()
                    && isText(request.resource.data.customer, 120)
                    && request.resource.data.stage in ["design", "revisi", "done"]
                    && isText(request.resource.data.deadline, 20);
      allow delete: if isAuthed();
    }

    /* ---------- Pesanan Produksi ----------
       Ditulis: { customer, stage, deadline, items, subtotal,
                  discount, total, notes, invoiceId?, createdAt }
       Field opsional seperti invoiceId boleh dihapus (deleteField). */
    match /production_orders/{id} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && isText(request.resource.data.customer, 120)
                    && isNum(request.resource.data.subtotal)
                    && isNum(request.resource.data.discount)
                    && isNum(request.resource.data.total);
      allow update: if isAuthed()
                    && isText(request.resource.data.customer, 120)
                    && isNum(request.resource.data.total)
                    && isOptNum(request.resource.data.subtotal);
      allow delete: if isAuthed();
    }

    /* ---------- Invoice ----------
       Ditulis: { customer, invoiceNo, date, status:"draft"|"paid",
                  items[], subtotal, discount, total, note,
                  productionId?, createdAt }
       productionId boleh dihapus (deleteField) -> tidak diwajibkan. */
    match /invoices/{id} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && isText(request.resource.data.customer, 120)
                    && isText(request.resource.data.invoiceNo, 40)
                    && request.resource.data.status in ["draft", "paid"]
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 500
                    && isNum(request.resource.data.subtotal)
                    && isNum(request.resource.data.discount)
                    && isNum(request.resource.data.total);
      allow update: if isAuthed()
                    && isText(request.resource.data.customer, 120)
                    && isText(request.resource.data.invoiceNo, 40)
                    && request.resource.data.status in ["draft", "paid"]
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 500
                    && isNum(request.resource.data.total);
      allow delete: if isAuthed();
    }

    /* ---------- Riwayat Estimasi Biaya (costing_history) ----------
       CATATAN: aplikasi saat ini belum menulis ke koleksi ini.
       Riwayat estimasi disimpan di localStorage (per perangkat),
       sedangkan listener onSnapshot tetap aktif membaca koleksi ini
       — hasilnya selalu kosong.
       Rules di bawah tetap dibuka agar bila nanti riwayat estimasi
       disinkronkan ke Firestore, tidak perlu mengubah rules lagi. */
    match /costing_history/{id} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && isNum(request.resource.data.total);
      allow update: if isAuthed() && isNum(request.resource.data.total);
      allow delete: if isAuthed();
    }

    /* ---------- PENOLAKAN DEFAULT ----------
       Semua koleksi di luar daftar di atas otomatis DITOLAK. */
    match /{document=**} {
      allow read, write: if false;
    }

    /* ==============================================================
       VARIAN B — TANPA AUTHENTICATION (opsional, tidak dipakai)
       ----------------------------------------------------------------
       Kalau tidak ingin memakai Anonymous Auth, ganti seluruh isi
       service cloud.firestore di atas dengan blok di bawah.
       ⚠ KELEMAHAN: siapa pun yang mengetahui projectId dapat menulis
         data melalui REST API, tanpa membuka aplikasi.
         Tetap perlu App Check untuk menutup celah ini.

       service cloud.firestore {
         match /databases/{database}/documents {
           match /design_customers/{id}    { allow read, write: if true; }
           match /design_orders/{id}       { allow read, write: if true; }
           match /production_orders/{id}   { allow read, write: if true; }
           match /invoices/{id}            { allow read, write: if true; }
           match /costing_history/{id}     { allow read, write: if true; }
           match /{document=**}            { allow read, write: if false; }
         }
       }
       ============================================================== */

  }
}